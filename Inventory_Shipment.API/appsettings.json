{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=Inventory_Shipment;Persist Security Info=True;User ID=sa;Password=123456;Pooling=False;MultipleActiveResultSets=False;Encrypt=False;TrustServerCertificate=True;Application Name=SQL SERVER Management Studio;Command Timeout=0"
  },
  "Database": {
    "CreateDatabaseIfMissing": true,
    "ApplySchemaOnStartup": true,
    "SchemaCommandTimeoutSeconds": 300
  },
  "Jwt": {
    "Issuer": "InventoryShipment.API",
    "Audience": "InventoryShipment.Client",
    "SecretKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Security": {
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "PasswordPolicy": {
      "MinLength": 8,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireNonAlphanumeric": true
    },
    "Argon2": {
      "MemoryKb": 65536,
      "Iterations": 3,
      "Parallelism": 4
    },
    "LoginRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Sales": {
    "MaxDiscountPercent": 100
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Seed": {
    "Enabled": true,
    "AdminUsername": "admin",
    "AdminEmail": "admin@inventory.local",
    "AdminFullName": "System Administrator",
    "AdminPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "PublicBaseUrl": ""
  },
  "Approvals": {
    "ReminderCheckMinutes": 15
  }
}
