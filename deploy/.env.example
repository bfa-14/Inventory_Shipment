# Settings for docker-compose.yml. setup.sh writes deploy/.env from this list with fresh secrets: one for
# production (/opt/inventory/Inventory_Shipment/deploy/.env) and, after "setup.sh testing", one for testing
# (/opt/inventory-test/Inventory_Shipment/deploy/.env). Edit .env (never this file) and run
# "docker compose up -d" in the same folder to apply a change.
#
# Values are read literally except for "$", which Compose expands: keep secrets to letters, digits, "-" and "_".

# production or testing: which environment this checkout runs. Required (the scripts add
# ENVIRONMENT=production to a production .env written before testing existed, never to testing's).
ENVIRONMENT=production

# The address of THIS environment, without https://. Its DNS A record must point at this server before the
# first start, so Let's Encrypt can issue the certificate. No domain yet? Use <ip-with-dashes>.sslip.io,
# e.g. 203-0-113-10.sslip.io for 203.0.113.10.
DOMAIN=erp.example.com

# The address of the testing environment. Production's proxy serves it, so production's .env needs it
# even before testing exists (its default is test.<DOMAIN>, which sslip.io resolves by itself; with your
# own domain, add a DNS A record for it too). Testing's .env repeats its own address here.
TEST_DOMAIN=test.erp.example.com

# Let's Encrypt writes here when a certificate is about to expire and could not be renewed.
ACME_EMAIL=admin@example.com

# The other environment's address, for the Production / Testing switch on the sign-in page. Written by
# "setup.sh testing" in both .env files; empty = no switch.
SWITCH_URL=

# The SQL Server "sa" password. At least 8 characters with upper case, lower case and digits.
MSSQL_SA_PASSWORD=

# The key that signs the sign-in tokens: 32+ random characters. Changing it signs everybody out.
JWT_SECRET_KEY=

# The first administrator's password (user "admin"). Used once, while the database has no users;
# change it in the app after the first sign-in.
ADMIN_PASSWORD=

# --- Testing only -----------------------------------------------------------------------------

# Emails of the testing environment are never sent to the real recipients (its data is a copy of
# production's). Set one address here to receive them ALL instead, subject "[TEST] ...".
#TEST_EMAIL_REDIRECT_TO=

# Written by "setup.sh testing" in testing's .env:
#COMPOSE_PROJECT_NAME=inventory-test       its own containers, volumes and images
#PROXY_REPLICAS=0                          ports 80/443 belong to production's proxy
#TUNNEL_PORT=8081                          its web app on the server's 127.0.0.1
#API_PORT=5081                             its API on the server's 127.0.0.1
#PRODUCTION_DIR=/opt/inventory/Inventory_Shipment   for copy-production-to-testing.sh

#OOM_SCORE_ADJ=500                         when memory runs out, testing is stopped before production

# Written by "setup.sh testing" in production's .env:
#TEST_DIR=/opt/inventory-test              where the testing checkouts are

# In production's .env: who may open the testing address (it holds a copy of production's data). Addresses
# or ranges separated by spaces, e.g. "203.0.113.10 198.51.100.0/24"; others get a 403 page. Empty = everyone.
#TEST_ALLOWED_IPS=

# --- Optional ---------------------------------------------------------------------------------

# Where this environment's web app and API listen on the server's 127.0.0.1 (the proxy and SSH tunnels
# use them). Production: 8080 and 5080. Production's proxy finds testing's at TEST_TUNNEL_PORT and
# TEST_API_PORT (8081 and 5081), which must match TUNNEL_PORT and API_PORT in testing's .env.
#TUNNEL_PORT=8080
#API_PORT=5080
#TEST_TUNNEL_PORT=8081
#TEST_API_PORT=5081

# SQL Server edition. Express is free for production (50 GB per database). "Web", "Standard" or a
# product key need a licence. Never "Developer": it is not licensed for production.
#MSSQL_PID=Express
#MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2025-latest
#MSSQL_MEMORY_LIMIT_MB=2048

# The database name.
#DB_NAME=Inventory_Shipment

# In testing's .env: its database in production's SQL Server instead of a SQL Server of its own (README.md, "One SQL
# Server for both environments"). Written by share-sql-server.sh, or by setup.sh testing for a new testing environment;
# not to be typed by hand. DB_NAME is then testing's own name, never production's; DB_USER is testing's own login,
# which owns that database and nothing else (DB_PASSWORD: its password, 16 letters and digits or more).
#SHARED_SQL=yes
#COMPOSE_FILE=docker-compose.yml:docker-compose.shared-sql.yml
#DB_NAME=Inventory_Shipment_Test
#DB_SERVER=inventory-db
#DB_USER=inventory_test
#DB_PASSWORD=

# Where the Inventory_Shipment_Frontend repository is checked out, relative to this folder.
#WEB_SOURCE_DIR=../../Inventory_Shipment_Frontend

# How many days of backups backup.sh keeps in deploy/backups.
#BACKUP_KEEP_DAYS=14

# The proxy's image.
#PROXY_IMAGE=caddy:2-alpine
